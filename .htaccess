# Production: force HTTPS on the live domain
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^smgarage\.thedigicraze\.com$ [NC]
  RewriteRule ^ https://smgarage.thedigicraze.com%{REQUEST_URI} [L,R=301]
</IfModule>
Options -Indexes
AddType application/manifest+json .webmanifest
DirectoryIndex index.php
<FilesMatch "^(config\.php|\.htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 10M
</IfModule>

# Block dotfiles such as .env
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
